// Banco no Prisma Postgres (Vercel Storage).
// Cada entidade do app (lib/types.ts → Db) vira uma linha em `Record`: a coleção ("users",
// "tests", "patients", "sessions", "forms"…) + o id do item + o objeto em JSON.
// Assim o lib/db.ts mantém a interface readDb()/updateDb() e o modelo de dados pode mudar
// sem exigir migração de tabela; só as linhas alteradas são gravadas.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Record {
  collection String
  id         String
  data       Json
  updatedAt  DateTime @updatedAt

  @@id([collection, id])
}

/// Conversas de cada pessoa com o assistente (app/painel/assistente). `messages` é o histórico no formato da API do Claude.
model AssistantConversation {
  id        String   @id
  userId    String
  title     String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

/// Lacunas: o que o assistente não conseguiu responder ou fazer. O dono lê em /painel/lacunas para saber o que falta na plataforma.
model AssistantGap {
  id             String    @id
  createdAt      DateTime  @default(now())
  userId         String
  userName       String
  role           String
  schoolId       String?
  schoolName     String?
  conversationId String?
  /// O que a pessoa pediu, nas palavras dela.
  question       String
  /// Por que não deu: sem_funcao | sem_dados | conhecimento | permissao | outro
  kind           String
  topic          String
  reason         String
  /// aberta | resolvida | ignorada
  status         String    @default("aberta")
  resolvedAt     DateTime?
  note           String?

  @@index([status, createdAt(sort: Desc)])
}
